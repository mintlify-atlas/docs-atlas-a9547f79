  "keyFeatures": [
    "Live microphone Cantonese ↔ English translation via Azure Speech STT/TTS",
    "Camera AR mode: point camera, tap shutter, get translated overlays",
    "Document translation for PDF, DOCX, PPTX, XLSX with layout preservation",
    "Jyutping romanization with Chao tone letters and character drill-down",
    "Freemium plans: Guest trial, Free, Family (4 seats), Business (10 seats)",
    "Pooled household usage metering via Supabase",
    "Harbor Quest gamified Cantonese learning feature",
    "Practice Partner AI conversation drill",
    "PWA installable with Android TWA / Play Store packaging",
    "Admin panel for user management, usage monitoring, and email campaigns"
  ],
